{
  "opencollection": "1.0.0",
  "info": {
    "name": "Segment Config Alias Profiles API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.segmentapis.com/v1beta/collections/users/profiles/:externalId/metadata",
            "params": [
              {
                "name": "externalId",
                "value": "",
                "type": "path",
                "description": "The external ID used to look up the profile. Format is type:value, such as user_id:abc123, email:user@example.com, or anonymous_id:xyz789."
              }
            ]
          },
          "docs": "Returns metadata for a user profile, including when the profile was created, last updated, and the total count of events and traits."
        }
      ]
    }
  ],
  "bundled": true
}