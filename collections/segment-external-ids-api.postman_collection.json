          "name": "Get user external IDs",
          "request": {
            "name": "Get user external IDs",
            "description": {
              "content": "Returns the external identifiers linked to a user profile. External IDs include user IDs, anonymous IDs, email addresses, and other identifiers that have been associated with the profile through identity resolution.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "collections",
                "users",
                "profiles",
                ":externalId",
                "external_ids"
