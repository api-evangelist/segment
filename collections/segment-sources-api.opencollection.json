{
  "opencollection": "1.0.0",
  "info": {
    "name": "Segment Config Alias Sources API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.segmentapis.com/v1beta/workspaces/:workspaceName/sources",
            "params": [
              {
                "name": "workspaceName",
                "value": "",
                "type": "path",
                "description": "The name of the workspace."
              }
            ]
          },
          "docs": "Returns a list of all sources in the specified workspace."
        },
        {
          "info": {
            "name": "Create source",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.segmentapis.com/v1beta/workspaces/:workspaceName/sources",
            "params": [
              {
                "name": "workspaceName",
                "value": "",
                "type": "path",
                "description": "The name of the workspace."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new source in the specified workspace."
        },
        {
          "info": {
            "name": "Get source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.segmentapis.com/v1beta/workspaces/:workspaceName/sources/:sourceName",
            "params": [
              {
                "name": "workspaceName",
                "value": "",
                "type": "path",
                "description": "The name of the workspace."
              },
              {
                "name": "sourceName",
                "value": "",
                "type": "path",
                "description": "The name of the source."
              }
            ]
          },
          "docs": "Returns a single source by name within the specified workspace."
        },
        {
          "info": {
            "name": "Delete source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://platform.segmentapis.com/v1beta/workspaces/:workspaceName/sources/:sourceName",
            "params": [
              {
                "name": "workspaceName",
                "value": "",
                "type": "path",
                "description": "The name of the workspace."
              },
              {
                "name": "sourceName",
                "value": "",
                "type": "path",
                "description": "The name of the source."
              }
            ]
          },
          "docs": "Deletes a source from the workspace by name."
        },
        {
          "info": {
            "name": "List sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.segmentapis.com/v1beta/sources",
            "params": [
              {
                "name": "pagination[cursor]",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination. Use the cursor returned in a previous response to fetch the next page."
              },
              {
                "name": "pagination[count]",
                "value": "",
                "type": "query",
                "description": "Number of items to return per page."
              }
            ]
          },
          "docs": "Returns a list of all sources in the workspace, including their configuration, write keys, and metadata."
        },
        {
          "info": {
            "name": "Create source",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.segmentapis.com/v1beta/sources",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new source in the workspace with the specified configuration and metadata."
        },
        {
          "info": {
            "name": "Get source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.segmentapis.com/v1beta/sources/:sourceId",
            "params": [
              {
                "name": "sourceId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the source."
              }
            ]
          },
          "docs": "Returns a single source by its ID, including its configuration, write key, and metadata."
        },
        {
          "info": {
            "name": "Update source",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://platform.segmentapis.com/v1beta/sources/:sourceId",
            "params": [
              {
                "name": "sourceId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the source."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing source with the provided configuration changes."
        },
        {
          "info": {
            "name": "Delete source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://platform.segmentapis.com/v1beta/sources/:sourceId",
            "params": [
              {
                "name": "sourceId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the source."
              }
            ]
          },
          "docs": "Deletes a source from the workspace by its ID. This action is irreversible."
        }
      ]
    }
  ],
  "bundled": true
}