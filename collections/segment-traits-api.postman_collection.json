        {
          "id": "108c3557-c420-4ffa-a829-46ce4c9732f9",
          "name": "Get user traits",
          "request": {
            "name": "Get user traits",
            "description": {
              "content": "Returns the traits for a user profile identified by an external ID. The external ID format is type:value, such as user_id:abc123 or email:user@example.com. Use the include parameter to specify which traits to retrieve for optimal performance.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "collections",
                "users",
                "profiles",
                ":externalId",
                "traits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Comma-separated list of trait names to include in the response. Recommended for best performance."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "The maximum number of items to return per page."
                },
                {
                  "disabled": false,
                  "key": "next",
                  "value": "<string>",
                  "description": "Pagination cursor to retrieve the next page of results."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "externalId",
                  "description": "(Required) The external ID used to look up the profile. Format is type:value, such as user_id:abc123, email:user@example.com, or anonymous_id:xyz789."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
